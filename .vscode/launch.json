{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch OctoFit Backend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/octofit-tracker/backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--loader", "ts-node/esm", "src/server.ts"],
      "env": {
        "PORT": "8000"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Launch OctoFit Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/octofit-tracker/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--host",
        "0.0.0.0"
      ],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Launch OctoFit Full Stack",
      "configurations": ["Launch OctoFit Backend", "Launch OctoFit Frontend"]
    }
  ]
}
